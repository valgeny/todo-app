{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "description": "To-do list API and web UI",
  "author": "Valerian Geny",
  "workspaces": [
    "server",
    "web",
    "mcp",
    "copilot"
  ],
  "scripts": {
    "start": "yarn workspace server start",
    "dev:server": "yarn workspace server debug",
    "dev:web": "yarn workspace web dev",
    "dev:web:docker": "yarn workspace web dev:docker",
    "dev:copilot": "yarn workspace copilot dev",
    "build": "yarn workspace web build",
    "build:copilot": "yarn workspace copilot build",
    "openapi:build": "yarn workspace server openapi:build",
    "mcp": "node --import tsx mcp/src/index.ts",
    "mcp:http": "yarn workspace mcp start:http",
    "mcp:inspect": "yarn workspace mcp inspect",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "yarn lint && yarn test:integration && yarn test:mcp",
    "test:integration": "yarn workspace server test",
    "test:integration:report": "allure open test-results/allure",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test-results/playwright",
    "test:mcp": "yarn workspace mcp test"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0"
  }
}
