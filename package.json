{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "description": "To-do list API and web UI",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "yarn workspace server start",
    "dev:server": "yarn workspace server debug",
    "dev:web": "yarn workspace web dev",
    "dev:web:docker": "yarn workspace web dev:docker",
    "build": "yarn workspace web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "yarn lint && yarn workspace server test"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
