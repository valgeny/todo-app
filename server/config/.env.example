# Copy to server/config/.env.local, .env.docker, .env.test, .env.dev, or .env.uat.
# APP_ENV selects the file. It defaults to local, or test when NODE_ENV=test.
APP_ENV=local
PORT=8000
# Bind address. Defaults to :: (Node's default). A Codespace sets HOST=0.0.0.0.
# HOST=0.0.0.0
# combined, common, dev, short, or tiny. Defaults to dev.
LOG_FORMAT=dev
# Comma-separated hostnames. A leading *. matches subdomains over https.
CORS_ORIGINS=localhost,127.0.0.1,*.app.github.dev

# --- Database: sqlite (default local/tests) or postgres (Docker / Cloud Run) ---
DB_DIALECT=sqlite
DB_NAME=data/todo.sqlite

# Docker compose Postgres (see docker-compose.yml):
# DB_DIALECT=postgres
# DB_HOST=todo-db
# DB_PORT=5432
# DB_USER=todo
# DB_PASSWORD=todo
# DB_NAME=todo

# Cloud Run (injected by Terraform — do not put secrets here):
# DB_DIALECT=postgres
# DB_HOST=/cloudsql/PROJECT:REGION:todo-ENV-pg
# DB_PORT=5432
# DB_USER=todo
# DB_PASSWORD=…   # Secret Manager
# DB_NAME=todo
