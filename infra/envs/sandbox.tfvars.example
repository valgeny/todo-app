# -----------------------------------------------------------------------------
# envs/sandbox.tfvars.example — sandbox app stack
#
# Requires nonprod Cloud SQL (todo-nonprod-pg) already applied.
#
#   terraform init -reconfigure -backend-config=backends/sandbox.hcl
#   terraform apply -var-file=envs/sandbox.tfvars
#
# Creates: DB todo_sandbox on todo-nonprod-pg + API/MCP/FE (todo-sandbox-*).
# -----------------------------------------------------------------------------

project_id  = "your-gcp-project-id"
environment = "sandbox"
region      = "us-central1"
name_prefix = "todo"

create_frontend_bucket = true

github_repository = "valgeny/todo-app"

# CORS_ORIGINS + DB_PASSWORD are managed; do not set DB_PASSWORD here.
secret_env = {}
