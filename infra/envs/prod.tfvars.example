# -----------------------------------------------------------------------------
# envs/prod.tfvars.example — production app env
#
# Same GCP project as nonprod: point at nonprod stack outputs (shared SQL/AR/WIF).
# Dedicated prod GCP project: apply stack with backends/prod.hcl first, then use
# todo-prod-* outputs below.
#
#   terraform -chdir=env init -reconfigure -backend-config=backends/prod.hcl
#   terraform -chdir=env apply -var-file=../envs/prod.tfvars
# -----------------------------------------------------------------------------

project_id  = "your-gcp-project-id"
environment = "prod"
region      = "us-central1"
name_prefix = "todo"

# Same-project: nonprod stack outputs. Dedicated prod project: todo-prod-* instead.
sql_instance_name               = "todo-nonprod-pg"
sql_connection_name             = "your-gcp-project-id:us-central1:todo-nonprod-pg"
artifact_registry_repository_id = "todo-nonprod-api"
artifact_registry_location      = "us-central1"
artifact_registry_name          = "todo-nonprod-api"
deploy_sa_email                 = "gh-deploy-nonprod@your-gcp-project-id.iam.gserviceaccount.com"
iap_oauth_client_id             = "xxxx.apps.googleusercontent.com"
iap_oauth_client_secret         = "GOCSPX-xxxx"
iap_members = [
  "group:eng@example.com",
]

secret_env = {}

agent_iap_host = "agent.example.com"
copilot_host   = "copilot.example.com"
agent_langsmith_api_key = "lsv2_pt_xxxx"
