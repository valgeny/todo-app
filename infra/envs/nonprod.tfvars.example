# -----------------------------------------------------------------------------
# envs/nonprod.tfvars.example — shared nonprod Cloud SQL instance
#
# Apply ONCE before sandbox or staging:
#   cp envs/nonprod.tfvars.example envs/nonprod.tfvars
#   terraform init -reconfigure -backend-config=backends/nonprod.hcl
#   terraform apply -var-file=envs/nonprod.tfvars
#
# Creates: todo-nonprod-pg (db-f1-micro). No Cloud Run.
# -----------------------------------------------------------------------------

project_id  = "your-gcp-project-id"
environment = "nonprod"
region      = "us-central1"
name_prefix = "todo"
