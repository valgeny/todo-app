# -----------------------------------------------------------------------------
# terraform.tfvars.example — quick-start vars (mirrors sandbox)
#
# Prefer env-specific files under envs/:
#   cp envs/sandbox.tfvars.example envs/sandbox.tfvars
#   terraform apply -var-file=envs/sandbox.tfvars
#
# Root terraform.tfvars is gitignored; do not commit secrets.
# -----------------------------------------------------------------------------

project_id  = "your-gcp-project-id"
environment = "sandbox"
region      = "us-central1"
name_prefix = "todo"

# After first apply creates Artifact Registry, build/push then set:
# image = "us-central1-docker.pkg.dev/your-gcp-project-id/todo-sandbox-api/todo-sandbox-api:latest"

create_frontend_bucket = true
github_repository      = "valgeny/todo-app"

# After first apply creates Artifact Registry, build/push then set:
# mcp_image = "us-central1-docker.pkg.dev/your-gcp-project-id/todo-sandbox-api/todo-sandbox-mcp:latest"

# Extra Secret Manager → Cloud Run env (CORS_ORIGINS is always managed).
# See envs/*.tfvars.example — use backends/*.hcl for per-env state.
# nonprod first (todo-nonprod-pg), then sandbox/staging; prod is separate.
# secret_env = {}
secret_env = {}
