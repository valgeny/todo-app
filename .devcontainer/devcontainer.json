{
  "name": "To-Do List",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "UI",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "API",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "HOST": "0.0.0.0"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
