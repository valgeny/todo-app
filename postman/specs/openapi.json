                "schema": {
                  "type": "object",
                  "properties": {
                    "errorId": {
                      "type": "string"
                    },
                    "errorText": {
                      "type": "string"
                    },
                    "loggingId": {
                      "nullable": true,
                      "type": "string"
                    },
                    "originalError": {
                      "nullable": true,
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "data": {}
