# Gemini (Google AI Studio). For Vertex later, switch model wiring in graph.py.
GOOGLE_API_KEY=

# Todo REST API (start with: yarn dev:server from repo root)
TODO_API_ORIGIN=http://127.0.0.1:8000

# Optional model id
GEMINI_MODEL=gemini-2.5-flash

# LangSmith (https://smith.langchain.com) — required for evals/tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=todo-agent
