# Gemini auth — pick one:
#   GOOGLE_API_KEY=...          → AI Studio
#   leave empty + set project   → Vertex + ADC (gcloud auth application-default login)
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Required: MCP Streamable HTTP endpoint (tools/list discovery)
# Deployed sandbox: https://todo-sandbox-mcp-….run.app/mcp
# Local MCP (optional): yarn mcp:http → http://127.0.0.1:8080/mcp
TODO_MCP_URL=

# Optional model id
GEMINI_MODEL=gemini-2.5-flash

# Optional IANA timezone for relative dates in the system prompt (default: host local)
# AGENT_TZ=America/Toronto

# LangSmith (https://smith.langchain.com) — required for evals/tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=todo-agent
