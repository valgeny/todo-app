{
  "name": "mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that exposes the To-Do List REST API as curated tools",
  "author": "Valerian Geny",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "start:http": "node --import tsx src/http.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "dev:http": "node --import tsx --watch src/http.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "inspect": "npx --yes @modelcontextprotocol/inspector node --import tsx src/index.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
